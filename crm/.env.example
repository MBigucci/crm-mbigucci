# Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable
# Pasta do site onde o módulo de Vendas fica (https://mbigucci.com.br/base360/vendas)
BASE_PATH=/base360/vendas
# Avisos no celular: a Public Key de "npx web-push generate-vapid-keys" (README, seção 8).
# A Private Key NUNCA vai aqui: fica só nos Secrets da Edge Function.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
