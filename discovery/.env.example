# URL do app da web do Google Apps Script (Implantar > Nova implantação > App da Web)
NEXT_PUBLIC_SHEETS_URL=
# Mesmo valor de TOKEN no apps-script/Code.gs (só permite gravar respostas)
NEXT_PUBLIC_SHEETS_TOKEN=
# Pasta do site onde a pesquisa vai ficar (padrão: /pesquisa)
BASE_PATH=/pesquisa

# Sem NEXT_PUBLIC_SHEETS_URL, o envio só aparece no console do navegador (para testar).
